# Скопируйте в .env и заполните. Файл .env не коммитить.

# API организаторов. Подписанные ссылки берутся из Student Guide и в репозиторий не попадают.
# Для контрольного набора организаторы сообщат другой group_id. Форма ссылки пока неизвестна:
# возможно, это тот же адрес с другим group_id, возможно, отдельная подписанная ссылка.
DEV_API_URL=
CONTROL_API_URL=

# Модель оценки. Пока LLM_PROVIDER пуст, judge отдаёт заглушку (ответы с "mock": true).
# Протоколы: anthropic (Messages API) или openai (OpenAI-совместимый chat/completions:
# OpenAI, Ollama, LM Studio, vLLM). Для локального сервера задайте LLM_BASE_URL, ключ не нужен.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MAX_TOKENS=1024
# Только для openai-протокола. Для «думающих» локальных моделей (Qwen3.5 в Ollama) поставьте none:
# иначе рассуждения съедают контекст, ответ приходит пустым и оценка занимает минуты.
# Значение, отличное от none, включает рассуждения: тогда temperature не отправляется,
# а голосование по шкальным критериям теряет смысл (можно поставить LLM_VOTES=1).
# LLM_REASONING_EFFORT=none
#
# Пример для OpenAI (цены за 1 млн токенов, сверьте с вашим кабинетом):
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-6-luna
# LLM_REASONING_EFFORT=none
# LLM_PRICE_IN=0.1
# LLM_PRICE_OUT=0.5
# Запусков для шкальных критериев (берётся медиана) и одновременных запросов
# LLM_VOTES=3
# LLM_CONCURRENCY=4
# Цена за 1 млн токенов, USD: нужна для расчёта стоимости одной оценки в результате
# LLM_PRICE_IN=
# LLM_PRICE_OUT=
# Каталог с system.txt и criterion.txt (от backend/), правка без пересборки
# PROMPTS_DIR=../config/prompts

# Сервер и хранилище результатов (storage/ в .gitignore)
PORT=8080
STORAGE_DIR=../storage
# CORS выключен: интерфейс и API отдаются с одного адреса. Если интерфейс разрабатывается на
# отдельном адресе, разрешите только его (один origin):
# CORS_ALLOW_ORIGIN=http://127.0.0.1:5173
# Каталог интерфейса, который отдаёт сервер (путь от backend/)
WEB_DIR=../web
